    "check-copy": "node scripts/check-copy.mjs",
    "icons": "node scripts/icons.mjs",
    "build:embedded": "node scripts/build-embedded-apps.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@auth/core": "^0.37.0",
    "@convex-dev/auth": "^0.0.92",
