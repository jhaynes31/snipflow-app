DATABASE_URL=(paste your Neon connection string here)
ANTHROPIC_API_KEY=(paste your Anthropic key here)
# Shared password for John's private tools (/dashboard and the generator hub).
# Required: without it the private pages and their server functions stay locked.
ADMIN_PASSWORD=(choose a long password)
# Optional: key used to sign the login cookie. If left unset a key is derived
# from ADMIN_PASSWORD, so changing the password signs every browser out.
AUTH_SECRET=
