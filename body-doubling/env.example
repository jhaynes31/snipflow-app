# Copy to .env.local for the Next.js app.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_COMMUNITY_NAME="Body Doubling with Jen & John"

# These live on the Convex deployment (npx convex env set NAME value), not in .env.local:
#   ADMIN_EMAILS=jen@example.com,john@example.com   # who sees the host tools
#   SITE_URL=https://your-site.example               # where Stripe sends people back to
#   STRIPE_SECRET_KEY=sk_live_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   JWT_PRIVATE_KEY / JWKS                           # set by `npx @convex-dev/auth`
