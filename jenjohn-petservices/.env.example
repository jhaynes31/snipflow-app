# Environment Variables for Jen & John's Pet Services
#
# Copy this file to .env and fill in the values. Every variable marked
# REQUIRED must be set or the matching feature refuses to run.

# ── Convex backend ──────────────────────────────────────────────────────────
# REQUIRED. Deployment URL (npx convex deploy prints it; also in the dashboard).
CONVEX_DEPLOYMENT_URL=
# REQUIRED. Deploy key for that deployment (Convex dashboard -> Settings ->
# Deploy keys). All Convex functions are internal and only run when the server
# presents this key, so nobody can reach the database without it. Server only.
CONVEX_DEPLOY_KEY=

# ── Admin sessions ───────────────────────────────────────────────────────────
# REQUIRED in production. Long random string (at least 32 chars) used to sign
# the admin session cookie. Generate with: openssl rand -hex 32
# If unset, a random per-process secret is used and every restart logs you out.
SESSION_SECRET=
# Seed admin password. Used only until a password has been set from the admin
# panel, after which the stored hash wins.
ADMIN_PASSWORD=
# Address that receives password reset links and new-request notifications.
ADMIN_EMAIL=jen.johnpetservices@proton.me

# ── Public site URL ──────────────────────────────────────────────────────────
# Used in emails (links back to the site and admin) and in password reset
# links. Set the SAME value in the Convex environment (npx convex env set
# SITE_PUBLIC_URL ...) so scheduled jobs call back to the right host.
SITE_PUBLIC_URL=https://jenjohnpetservices.com

# ── Scheduled job callbacks ──────────────────────────────────────────────────
# REQUIRED. Shared secrets that authorize Convex scheduled jobs to call the
# site's /api/post-completion and /api/deposit-reminder endpoints. Generate two
# different values (openssl rand -hex 24) and set each in BOTH places:
#   .env (here)  and  npx convex env set POST_COMPLETION_SECRET <value>
#                     npx convex env set DEPOSIT_REMINDER_SECRET <value>
POST_COMPLETION_SECRET=
DEPOSIT_REMINDER_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_EMAIL_FROM=bookings@jenjohnpetservices.com

# ── Optional integrations ────────────────────────────────────────────────────
# Distance provider for the Meet & Greet fee (leave blank for manual miles).
GOOGLE_MAPS_API_KEY=
MAPBOX_API_KEY=
# Google AI (Gemini) key for the private /content Content Studio (unfinished).
GOOGLE_API_KEY=
