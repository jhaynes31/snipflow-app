generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Team {
  leadership
  marketing
  dev
  custom
}

enum ModelTier {
  fast
  smart
}

enum Shift {
  day
  night
  always
}

enum AgentStatus {
  sleeping
  idle
  walking
  working
  waiting_review
  handing_off
  blocked
  celebrating
}

enum ProjectStatus {
  active
  paused
  killed
}

enum GoalStatus {
  planning
  running
  needs_review
  done
  failed
  blocked
}

enum TaskStatus {
  queued
  in_progress
  needs_review
  approved
  rejected
  done
  failed
  blocked
}

enum TaskKind {
  plan // Strategist turns a goal into a task graph
  work // anything an agent produces
}

model Agent {
  id               String      @id @default(cuid())
  name             String
  role             String // template key, e.g. "copywriter"
  team             Team
  avatarSpriteKey  String
  personality      String
  systemPrompt     String
  skills           String[]
  tools            String[]
  model            ModelTier
  dailyTokenBudget Int
  shift            Shift       @default(always)
  status           AgentStatus @default(idle)
  currentTaskId    String?
  styleNotes       String      @default("")
  tasksDone        Int         @default(0)
  lastActiveAt     DateTime?
  archived         Boolean     @default(false)
  createdAt        DateTime    @default(now())

  tasks        Task[]
  deliverables Deliverable[]
  usage        UsageEntry[]
  events       AgentEvent[]
}

model Project {
  id                 String        @id @default(cuid())
  name               String
  description        String        @default("")
  brandKit           Json          @default("{}")
  monthlyBudgetCap   Float         @default(20)
  approvalLock       Boolean       @default(false)
  status             ProjectStatus @default(active)
  createdAt          DateTime      @default(now())

  goals        Goal[]
  tasks        Task[]
  deliverables Deliverable[]
}

model Goal {
  id          String     @id @default(cuid())
  title       String
  brief       String
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id])
  status      GoalStatus @default(planning)
  createdBy   String     @default("me")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  tasks Task[]
}

model Task {
  id               String     @id @default(cuid())
  goalId           String
  goal             Goal       @relation(fields: [goalId], references: [id])
  projectId        String
  project          Project    @relation(fields: [projectId], references: [id])
  kind             TaskKind   @default(work)
  // Key inside the plan ("draft", "edit"); unique per goal so a replayed plan
  // step can never create the same task twice.
  planKey          String
  title            String
  brief            String
  role             String
  assignedAgentId  String?
  assignedAgent    Agent?     @relation(fields: [assignedAgentId], references: [id])
  createdBy        String     @default("me")
  status           TaskStatus @default(queued)
  priority         Int        @default(3)
  dependsOn        String[]   // task ids
  requiresApproval Boolean    @default(false)
  attempts         Int        @default(0)
  maxSteps         Int        @default(8)
  maxTokens        Int        @default(20000)
  lastError        String?
  reviewNotes      String?
  startedAt        DateTime?
  finishedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  steps        TaskStep[]
  deliverables Deliverable[]
  usage        UsageEntry[]

  @@unique([goalId, planKey])
  @@index([status])
}

// One row per model call, keyed by (task, attempt, step). A worker that dies
// mid-task replays saved steps instead of paying for them again.
model TaskStep {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  attempt   Int
  step      Int
  response  Json
  // Saved after the step's tools run, so a replay never re-runs a tool.
  toolResults Json?
  createdAt DateTime @default(now())

  @@unique([taskId, attempt, step])
}

model Deliverable {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id])
  attempt   Int
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id])
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  title     String
  format    String // md | html | svg | csv | json
  path      String // relative to DATA_DIR
  createdAt DateTime @default(now())

  @@unique([taskId, attempt])
}

model UsageEntry {
  id           String   @id @default(cuid())
  agentId      String
  agent        Agent    @relation(fields: [agentId], references: [id])
  taskId       String
  task         Task     @relation(fields: [taskId], references: [id])
  projectId    String
  provider     String
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Float
  createdAt    DateTime @default(now())

  // Same key as TaskStep: a replayed step is never billed twice.
  attempt Int
  step    Int

  @@unique([taskId, attempt, step])
  @@index([createdAt])
}

model AgentEvent {
  id        BigInt   @id @default(autoincrement())
  type      String // Section 17 names: agent.wake, task.start, task.step, ...
  agentId   String?
  agent     Agent?   @relation(fields: [agentId], references: [id])
  taskId    String?
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Single row (id = "global").
model Settings {
  id              String  @id @default("global")
  dailyCapUsd     Float   @default(3)
  monthlyCapUsd   Float   @default(50)
  paused          Boolean @default(false)
  autoApprovePlans Boolean @default(true)
}
